# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
VITE_SUPABASE_URL="your_supabase_url"

# EmailJS Configuration
# Get these values from https://dashboard.emailjs.com
# 1. Service ID: Go to Email Services page
# 2. Template ID: Go to Email Templates page (use template_rqysnu6 for welcome emails)
# 3. Public Key: Go to Account → General page
VITE_EMAILJS_SERVICE_ID="your_service_id_here"
VITE_EMAILJS_WELCOME_TEMPLATE_ID="template_rqysnu6"
VITE_EMAILJS_PUBLIC_KEY="your_public_key_here"

# Optional: Email delay in milliseconds (default: 30000 = 30 seconds)
VITE_WELCOME_EMAIL_DELAY_MS="30000"

# Google Maps API Configuration
# Get your API key from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
